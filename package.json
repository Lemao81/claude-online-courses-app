{
  "name": "claudeonlinecoursesapp",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.19.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.21.0"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12.10.1"
    }
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "start:all": "pnpm docker:up && pnpm dev",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "git config core.hooksPath .githooks",
    "postinstall": "pnpm chakra:typegen",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "es:lint": "eslint .",
    "es:fix": "eslint . --fix",
    "bm:check:ci": "biome ci",
    "bm:check:dev": "biome check",
    "bm:fix": "biome check --write",
    "docker:up": "docker compose --env-file .env.local up -d",
    "docker:down": "docker compose --env-file .env.local down",
    "docker:build": "docker compose --env-file .env.local build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx --env-file=.env.local src/server/db/seed.ts",
    "db:pull": "drizzle-kit pull",
    "db:studio": "drizzle-kit studio",
    "chakra:typegen": "chakra typegen src/theme/index.ts --strict --tsconfig tsconfig.json",
    "chakra:eject": "chakra eject --outdir src/theme/eject",
    "worker": "tsx --env-file=.env.local src/server/worker.ts",
    "worker:dashboard": "cross-env PORT=3001 HOST=localhost node --env-file=.env.local node_modules/@pg-boss/dashboard/bin/cli.js"
  },
  "dependencies": {
    "@chakra-ui/react": "3.36.0",
    "@clerk/tanstack-react-start": "1.4.10",
    "@dnd-kit/abstract": "0.5.0",
    "@dnd-kit/helpers": "0.5.0",
    "@dnd-kit/react": "0.5.0",
    "@emotion/react": "11.14.0",
    "@fontsource-variable/figtree": "5.3.0",
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/literata": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "5.3.0",
    "@pg-boss/dashboard": "1.6.4",
    "@tanstack/react-devtools": "0.10.8",
    "@tanstack/react-form": "1.33.0",
    "@tanstack/react-query": "5.101.2",
    "@tanstack/react-query-devtools": "5.101.2",
    "@tanstack/react-router": "1.170.16",
    "@tanstack/react-router-devtools": "1.167.0",
    "@tanstack/react-router-ssr-query": "1.167.1",
    "@tanstack/react-start": "1.168.26",
    "drizzle-kit": "0.31.10",
    "drizzle-orm": "0.45.2",
    "drizzle-seed": "0.3.1",
    "lucide-react": "0.545.0",
    "minio": "8.0.7",
    "next-themes": "0.4.6",
    "pg": "8.22.0",
    "pg-boss": "12.26.4",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-icons": "5.7.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@chakra-ui/cli": "3.36.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "@tanstack/devtools-vite": "0.8.5",
    "@tanstack/router-cli": "1.167.17",
    "@testcontainers/postgresql": "12.1.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.13.3",
    "@types/pg": "8.20.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "cross-env": "10.1.0",
    "dotenv": "17.4.2",
    "eslint": "10.11.0",
    "jsdom": "28.1.0",
    "tsx": "4.22.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.1.0",
    "vitest": "5.0.3"
  }
}
